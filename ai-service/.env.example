# ==============================================================
# 大健康智能问诊系统 - AI 服务环境变量
# 复制为 .env 并填入真实配置：cp .env.example .env
# ==============================================================

# ---------- LLM 配置（DeepSeek，OpenAI 兼容接口） ----------
# DeepSeek API Key，前往 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI 兼容接口地址（DeepSeek 官方）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名：deepseek-chat(对话) / deepseek-reasoner(推理)
LLM_MODEL=deepseek-chat
TEMPERATURE=0.3
LLM_TIMEOUT=60
MAX_TOKENS=1024

# ---------- 嵌入模型配置（本地 sentence-transformers） ----------
# 中文嵌入模型，首次运行自动下载（约 100MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 若无法访问 HuggingFace，请取消注释使用国内镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 向量数据库（ChromaDB 持久化） ----------
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=health_knowledge
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ---------- 服务 ----------
DEBUG=true
